@model Ark.oAuth.Oidc.Endpoints.OidcErrorPageModel
@{
    Layout = "~/Views/Oidc/_ArkLayout.cshtml";
    ViewBag.Brand = Model.Brand;
    ViewBag.PageTitle = $"Signed out · {Model.Brand.HostName}";
}

<div class="ark-icon-badge ark-icon-badge--success" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M5 10.5l3.2 3.2L15 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</div>

<h1>You're signed out</h1>
<p class="ark-sub">@(Model.Description ?? "Your session has ended.")</p>

<p class="ark-meta">
    For extra safety on a shared computer, close the browser entirely.
</p>
